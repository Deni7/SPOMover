@page "/profiles"
@inject SettingsService Settings
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@T("Profiles") — SPOMover</PageTitle>

<SettingsList Kind="@SettingKinds.Profile" Route="profiles" Title="@T("Run profiles")" Help="S2" ExtraTitle="@T("Libraries · connections")" Extra="Describe">
    <RowActions Context="name">
        <MudTooltip Text="@T("Start a run")"><MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" OnClick="() => Run(name)" /></MudTooltip>
    </RowActions>
</SettingsList>

@code {
    private string Describe(string name)
    {
        var p = Settings.GetProfile(name);
        if (p is null)
            return string.Empty;
        string libraries = p.TargetLibraries.Count == 0 ? "—" : string.Join(", ", p.TargetLibraries);
        string mapping = T($"mapping: {p.Mapping.Count} rows");
        string targets = p.Source is null ? T("no source") : $"{p.Source.Library} → {libraries} · {mapping}";
        string pool = p.Pool.Enabled ? T(" (pool)") : "";
        return $"{targets} · {(p.Connections.Count == 0 ? "—" : string.Join(", ", p.Connections))}{pool}";
    }

    private async Task Run(string name)
    {
        var dialog = await Dialogs.ShowAsync<NewRunDialog>(T("New run"), new DialogParameters<NewRunDialog> { { x => x.Profile, name } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: long id })
            Nav.NavigateTo($"runs/{id}");
    }
}
