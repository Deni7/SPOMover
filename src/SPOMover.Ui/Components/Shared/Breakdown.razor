<MudPaper Class="pa-3" Elevation="1">
    <MudText Typo="Typo.subtitle1">@Title</MudText>
    @if (Rows.Count == 0)
    {
        <MudText Typo="Typo.caption">@T("No data")</MudText>
    }
    else if (Stacked)
    {
        @* Long names (library addresses): the name gets the whole width, the numbers go under it. *@
        @foreach (var r in Rows)
        {
            double percent = Percent(r);
            <div class="breakdown-row">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline" Spacing="2">
                    <div style="min-width:0">
                        <MudText Typo="Typo.body2" Class="wrap-anywhere"><b>@r.Key</b></MudText>
                        @if (r.Detail is { Length: > 0 } detail)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary wrap-anywhere" Style="display:block">@detail</MudText>
                        }
                    </div>
                    @if (Share)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(r.Stage == T("done") ? Color.Success : r.Progress is not null || r.Moving ? Color.Primary : Color.Default)">@r.Stage</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="nowrap">@percent.ToString("0.0", Ui.Culture)%</MudText>
                    }
                </MudStack>
                @if (!Share)
                {
                    <MudProgressLinear Value="percent" Color="Color.Primary" Rounded="true" Class="my-1" />
                }
                else if (r.Progress is { } progress)
                {
                    <MudProgressLinear Value="progress" Color="Color.Primary" Rounded="true" Class="my-1" />
                }
                else if (r.Moving)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Class="my-1" />
                }
                <MudText Typo="Typo.caption">
                    @T("Files:") <b>@Ui.N(r.Total)</b> · @T("Size:") <b>@Ui.Size(r.Bytes)</b> ·
                    @if (Share)
                    {
                        <span>@T("Folders:") <b>@Ui.N(r.Folders)</b> · </span>
                    }
                    else
                    {
                        <span>@T("Processed:") <b>@Ui.N(r.Finished)</b> · </span>
                    }
                    @T("Errors:") <b class="@(r.Failed > 0 ? "mud-error-text" : null)">@(r.Failed > 0 ? Ui.N(r.Failed) : "—")</b>
                </MudText>
            </div>
        }
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr><th></th><th>@T("File count")</th><th>@T("Total size")</th><th>@(Share ? T("Share of files") : T("Processed"))</th><th>@T("Errors")</th><th style="width:20%;min-width:60px"></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Rows)
                {
                    <tr>
                        <td class="nowrap">@r.Key</td>
                        <td>@Ui.N(r.Total)</td>
                        <td class="nowrap">@Ui.Size(r.Bytes)</td>
                        <td>@(Share ? ShareOf(r).ToString("0.0", Ui.Culture) + "%" : Ui.N(r.Finished))</td>
                        <td>@(r.Failed > 0 ? Ui.N(r.Failed) : "—")</td>
                        <td><MudProgressLinear Value="@(Share ? ShareOf(r) : Percent(r))" Color="Color.Primary" /></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    /// <param name="Detail">Second line under the name in the stacked view (the site of a library).</param>
    public sealed record Row(string Key, long Total, long Bytes, long Finished, long Failed, string? Detail = null)
    {
        /// <summary>With <see cref="Share"/>: the stage shown instead of the percentage (a library of an inventory).</summary>
        public string? Stage { get; init; }

        /// <summary>With <see cref="Share"/>: the bar, only where it means something; null — no bar.</summary>
        public double? Progress { get; init; }

        /// <summary>With <see cref="Share"/>: work goes on without a known total — a running bar.</summary>
        public bool Moving { get; init; }

        public long Folders { get; init; }
    }

    /// <summary>
    /// An inventory: nothing is «processed» there (every listed file is final), so the table shows each row's share of
    /// the files and the stacked view the stage of each library instead of a bar that is always full.
    /// </summary>
    [Parameter] public bool Share { get; set; }

    private double ShareOf(Row r) => Rows.Sum(x => x.Total) is > 0 and var all ? 100.0 * r.Total / all : 0;

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<Row> Rows { get; set; } = [];
    /// <summary>One block per row instead of a table, for long names.</summary>
    [Parameter] public bool Stacked { get; set; }

    private static double Percent(Row r) => r.Total > 0 ? 100.0 * r.Finished / r.Total : 0;
}
