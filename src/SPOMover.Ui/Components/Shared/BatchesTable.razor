@* GUI-1, GUI-4: the batches of an apply run with their state, refreshed while the run works. *@
@implements IDisposable
@inject RunService Runs

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
    <MudSelect T="string" Label="@T("State")" @bind-Value="_status" Dense="true" Margin="Margin.Dense" Style="max-width:240px">
        <MudSelectItem Value="@("")">@T("all")</MudSelectItem>
        @foreach (var s in _batches.Select(b => b.Status).Distinct().Order())
        {
            <MudSelectItem Value="@s">@Ui.BatchStatus(s) (@Ui.N(_batches.Count(b => b.Status == s)))</MudSelectItem>
        }
    </MudSelect>
    <MudTextField T="string" Label="@T("Search in paths")" @bind-Value="_search" Immediate="true" DebounceInterval="300" Margin="Margin.Dense" Clearable="true" Style="max-width:320px" />
    <MudSpacer />
    <MudText Typo="Typo.caption">@T($"Batches: {Ui.N(_batches.Count)}; done {Ui.N(_batches.Count(b => b.Status == StateStore.BatchStatuses.Done))}")</MudText>
</MudStack>
<MudTable T="StateStore.ApplyBatch" Items="Filtered" Dense="true" Hover="true" RowsPerPage="50" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>№</MudTh><MudTh>@T("Wave")</MudTh><MudTh>@T("Kind")</MudTh><MudTh>@T("Source")</MudTh><MudTh>@T("Target")</MudTh><MudTh>@T("File count")</MudTh><MudTh>@T("State")</MudTh><MudTh>@T("Attempts")</MudTh><MudTh>@T("Duration")</MudTh><MudTh>@T("Details")</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Seq</MudTd>
        <MudTd>@context.Wave</MudTd>
        <MudTd>@(context.IsFolder ? T("folder") : T("files"))</MudTd>
        <MudTd Class="wrap-anywhere">@Ui.Path(context.Source)</MudTd>
        <MudTd Class="wrap-anywhere">@context.Library:/@context.Target</MudTd>
        <MudTd>@Ui.N(context.Files)</MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Color="@Ui.BatchColor(context.Status)">@Ui.BatchStatus(context.Status)</MudChip></MudTd>
        <MudTd>@context.Attempts</MudTd>
        <MudTd class="nowrap">@Duration(context)</MudTd>
        <MudTd Class="wrap-anywhere">
            @context.Error
            @if (context.NotBefore is { } nb && !StateStore.BatchStatuses.IsFinal(context.Status))
            {
                <span class="mud-text-secondary"> · @T($"retry after {Ui.Time(nb)}")</span>
            }
            @if (context.Status is StateStore.BatchStatuses.Partial || context.Status.StartsWith("failed:", StringComparison.Ordinal))
            {
                <MudLink Href="@($"runs/{RunId}?tab=errors&show=failed")" Class="ml-1">@T("files")</MudLink>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>@T("No batches match these conditions.")</NoRecordsContent>
    <PagerContent><MudTablePager RowsPerPageString="@T("Rows:")" /></PagerContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public long RunId { get; set; }

    private IReadOnlyList<StateStore.ApplyBatch> _batches = [];
    private string _status = string.Empty;
    private string? _search;
    private Timer? _timer;

    protected override void OnParametersSet()
    {
        Load();
        _timer ??= new Timer(_ => InvokeAsync(() =>
        {
            if (Runs.Active is { } a && a.RunId == RunId && !a.Completion.IsCompleted)
            {
                Load();
                StateHasChanged();
            }
        }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void Load() => _batches = Runs.Store.GetApplyBatches(RunId);

    private IEnumerable<StateStore.ApplyBatch> Filtered =>
        _batches.Where(b => (_status.Length == 0 || b.Status == _status)
            && (string.IsNullOrWhiteSpace(_search) || b.Source.Contains(_search, StringComparison.CurrentCultureIgnoreCase) || b.Target.Contains(_search, StringComparison.CurrentCultureIgnoreCase)));

    private static string Duration(StateStore.ApplyBatch b) =>
        b.StartedAt is not { } s ? "" : Ui.Duration((b.FinishedAt ?? (b.Status == StateStore.BatchStatuses.InProgress ? DateTimeOffset.UtcNow : s)) - s);

    public void Dispose() => _timer?.Dispose();
}
